# Streaming Data Processor - Environment Configuration
# Copy this file to .env and adjust values as needed

# Kafka
STREAM_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Redis
STREAM_REDIS_HOST=localhost
STREAM_REDIS_PORT=6379
STREAM_REDIS_DB=0

# Database
STREAM_DATABASE_URL=sqlite:///./streaming.db

# Topics
STREAM_RAW_EVENTS_TOPIC=raw-events
STREAM_ENRICHED_EVENTS_TOPIC=enriched-events
STREAM_FRAUD_ALERTS_TOPIC=fraud-alerts
STREAM_DEAD_LETTER_TOPIC=dead-letter

# Deduplication
STREAM_DEDUP_TTL_SECONDS=3600

# Windowing
STREAM_WINDOW_SIZE_SECONDS=60
